<style>
  .navbar {
    padding: 0.6rem 1rem;
  }


  .explore-link {
    font-weight: 500;
    margin-left: 8px;
  }


  .search-container {
    max-width: 380px;
    width: 100%;
  }


  .search-inp {
    border-radius: 25px;
    padding: 0.45rem 1rem;
    font-size: 0.95rem;
  }


  .search-btn {
    background: #fe424d;
    color: white;
    border: none;
    border-radius: 25px;
    padding: 0.45rem 1rem;
    white-space: nowrap;
    font-size: 0.9rem;
  }

  .search-btn:hover {
    background: #e0333e;
  }


  @media (max-width:767px) {

    .search-container {
      display: none;
    }

    #navbarNav.show {
      background: white;
      margin-top: 10px;
      padding: 10px 14px;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    #navbarNav .nav-link {
      padding: 6px 4px;
    }

    .my-text {
      display: none;
    }


  }



  @media (max-width:767px) {

    .my-text {
      display: none;
    }

  }


  @media (min-width:768px) and (max-width:1023px) {

    .search-container {
      max-width: 30rem;
    }

    .search-inp {
      margin-left: 2rem;
    }

    .search-btn {
      margin-right: 1.5em;
    }

  }


  @media (min-width:1024px) and (max-width:1440px) {

    .search-container {
      max-width: 60rem;
    }

    .search-inp {
      margin-left: 10rem;
    }

    .search-btn {
      margin-right: 5rem;
    }


  }


  @media (min-width:1441px) {

    .search-container {
      max-width: 60rem;
    }

    .search-inp {
      margin-left: 10rem;
    }

    .search-btn {
      margin-right: 5rem;
    }

  }
</style>


<nav class="navbar navbar-expand-md border-bottom sticky-top bg-white">

  <div class="container-fluid">

    <!-- LEFT SIDE -->
    <div class="d-flex align-items-center">

      <a class="navbar-brand" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>

      <a class="nav-link explore-link" href="/listings">Explore</a>

    </div>


    <!-- CENTER SEARCH -->
    <form class="d-flex mx-auto search-container" action="/listings/search" method="GET">

      <input class="form-control me-2 search-inp" type="search" name="q" placeholder="Search destination">

      <button class="btn search-btn" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i><span class="my-text">Search</span>
      </button>

    </form>


    <!-- TOGGLE -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>


    <div class="collapse navbar-collapse" id="navbarNav">

      <!-- RIGHT SIDE -->
      <div class="navbar-nav ms-auto">

        <a class="nav-link" href="/listings/new">Become the host</a>

        <% if (!currUser) { %>
        <a class="nav-link fw-semibold" href="/signup">Sign Up</a>
        <a class="nav-link fw-semibold" href="/login">Log in</a>
        <% } %>

        <% if (currUser) { %>
        <a class="nav-link fw-semibold" href="/logout">Log out</a>
        <% } %>

      </div>

    </div>

  </div>
</nav>